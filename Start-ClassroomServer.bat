@echo off
chcp 65001 >nul
title خادم اختبارات الحصة الذكية - Classroom Quiz Server
color 0B
cls

echo ===============================================================================
echo                خادم اختبارات الحصة الذكية - Classroom Quiz Server
echo                   تشغيل الخادم المحلي على شبكة الفصل (بدون نت)
echo ===============================================================================
echo.
echo [1/3] جاري فحص بايثون والشبكة المحلية...

where python >nul 2>nul
if %errorlevel% neq 0 (
    where py >nul 2>nul
    if %errorlevel% neq 0 (
        echo [تنبيه] بايثون غير مثبت في نظامك!
        echo جاري تشغيل النسخة الاحتياطية عبر Node.js...
        Run_Classroom_Server.cmd
        exit /b
    ) else (
        set "PY_CMD=py"
    )
) else (
    set "PY_CMD=python"
)

echo [2/3] تم العثور على محرك التشغيل! جاري تشغيل الخادم على كروت الشبكة...
echo.
echo ===============================================================================
echo  الخادم جاهز لاستقبال حتى 50 طالباً في وقت واحد بدون أي تعليق!
echo  اترك هذه النافذة مفتوحة طوال الحصة.
echo ===============================================================================
echo.

%PY_CMD% classroom_server.py
pause
